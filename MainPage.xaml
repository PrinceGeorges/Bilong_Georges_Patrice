<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bilong_Georges_Patrice.MainPage"
             BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="14">

        <!-- ===== ÉCRAN D'AFFICHAGE ===== -->
        <Border Grid.Row="0"
                Stroke="#D1D1D6"
                StrokeThickness="1"
                Padding="18"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                <Label x:Name="OperationLabel"
                       Text=""
                       FontSize="16"
                       TextColor="#8E8E93"
                       HorizontalOptions="End" />
                <Label x:Name="ResultLabel"
                       Text="0"
                       FontSize="44"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"
                       HorizontalOptions="End" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== CLAVIER ===== -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="*,*,*,*,*"
              ColumnSpacing="10"
              RowSpacing="10">

            <!-- Ligne 1 -->
            <Button Grid.Row="0" Grid.Column="0" Text="C"
                    Clicked="OnClear" BackgroundColor="#FFCCCC" TextColor="#B00020"
                    FontSize="22" FontAttributes="Bold" CornerRadius="16" />
            <Button Grid.Row="0" Grid.Column="1" Text="CE"
                    Clicked="OnClearEntry" BackgroundColor="#FFCCCC" TextColor="#B00020"
                    FontSize="22" FontAttributes="Bold" CornerRadius="16" />
            <Button Grid.Row="0" Grid.Column="2" Text="%"
                    Clicked="OnPercent" BackgroundColor="#FFE5B4" TextColor="#B26A00"
                    FontSize="22" FontAttributes="Bold" CornerRadius="16" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷"
                    Clicked="OnOperator" CommandParameter="/"
                    BackgroundColor="#B4D7FF" TextColor="#004C99"
                    FontSize="24" FontAttributes="Bold" CornerRadius="16" />

            <!-- Ligne 2 -->
            <Button Grid.Row="1" Grid.Column="0" Text="7"
                    Clicked="OnNumber" CommandParameter="7"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="1" Grid.Column="1" Text="8"
                    Clicked="OnNumber" CommandParameter="8"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="1" Grid.Column="2" Text="9"
                    Clicked="OnNumber" CommandParameter="9"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="1" Grid.Column="3" Text="×"
                    Clicked="OnOperator" CommandParameter="*"
                    BackgroundColor="#B4D7FF" TextColor="#004C99"
                    FontSize="24" FontAttributes="Bold" CornerRadius="16" />

            <!-- Ligne 3 -->
            <Button Grid.Row="2" Grid.Column="0" Text="4"
                    Clicked="OnNumber" CommandParameter="4"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="2" Grid.Column="1" Text="5"
                    Clicked="OnNumber" CommandParameter="5"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="2" Grid.Column="2" Text="6"
                    Clicked="OnNumber" CommandParameter="6"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="2" Grid.Column="3" Text="−"
                    Clicked="OnOperator" CommandParameter="-"
                    BackgroundColor="#B4D7FF" TextColor="#004C99"
                    FontSize="24" FontAttributes="Bold" CornerRadius="16" />

            <!-- Ligne 4 -->
            <Button Grid.Row="3" Grid.Column="0" Text="1"
                    Clicked="OnNumber" CommandParameter="1"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="3" Grid.Column="1" Text="2"
                    Clicked="OnNumber" CommandParameter="2"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="3" Grid.Column="2" Text="3"
                    Clicked="OnNumber" CommandParameter="3"
                    BackgroundColor="White" TextColor="#1C1C1E"
                    FontSize="24" CornerRadius="16" />
            <Button Grid.Row="3" Grid.Column="3" Text="+"
                    Clicked="OnOperator" CommandParameter="+"
                    BackgroundColor="#B4D7FF" TextColor="#004C99"
                    FontSize="24" FontAttributes="Bold" CornerRadius="16" />

            <!-- Ligne 5 : FlexLayout pour +/-, 0, . -->
            <FlexLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Direction="Row" JustifyContent="SpaceBetween" AlignItems="Stretch">
                <Button Text="+/-"
                        Clicked="OnSign"
                        BackgroundColor="White" TextColor="#1C1C1E"
                        FontSize="22" CornerRadius="16"
                        FlexLayout.Basis="32%" />
                <Button Text="0"
                        Clicked="OnNumber" CommandParameter="0"
                        BackgroundColor="White" TextColor="#1C1C1E"
                        FontSize="24" CornerRadius="16"
                        FlexLayout.Basis="32%" />
                <Button Text="."
                        Clicked="OnDecimal"
                        BackgroundColor="White" TextColor="#1C1C1E"
                        FontSize="24" CornerRadius="16"
                        FlexLayout.Basis="32%" />
            </FlexLayout>

            <!-- Bouton = -->
            <Button Grid.Row="4" Grid.Column="3" Text="="
                    Clicked="OnEquals"
                    BackgroundColor="#B4F0C0" TextColor="#006622"
                    FontSize="26" FontAttributes="Bold" CornerRadius="16" />
        </Grid>

        <!-- ===== PIED DE PAGE (ScrollView) ===== -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="10" Padding="4">
                <Label Text="Calculatrice .NET MAUI" FontSize="12" TextColor="#8E8E93" />
                <Label Text="•" FontSize="12" TextColor="#8E8E93" />
                <Label Text="BIlong Georges Patrice" FontSize="12" TextColor="#8E8E93" />
                <Label Text="•" FontSize="12" TextColor="#8E8E93" />
                <Label Text="22G00056" FontSize="12" TextColor="#8E8E93" />
            </HorizontalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>